# Local fallback relay (relay/fallback-local.sh). Copy to relay/.env.local and fill in.
# Gitignored once copied: it contains the YouTube stream keys.

# Publish credentials used by the "AG secours local" OBS profile
# (srt://127.0.0.1:8890?streamid=publish:ag:<user>:<pass>...). Generate with: openssl rand -hex 24
RELAY_PUBLISH_USER=publisher
RELAY_PUBLISH_PASS=

# Same YouTube keys as in Dokploy (the local relay replaces the VPS on the same events).
YOUTUBE_URL_A=rtmps://a.rtmps.youtube.com/live2/<key A>
YOUTUBE_URL_B=rtmps://a.rtmps.youtube.com/live2/<key B>

TRAD_BITRATE=48k
# RELAY_PUBLIC_IP is detected by fallback-local.sh (the laptop's LAN address).
