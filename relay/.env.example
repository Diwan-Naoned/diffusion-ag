# Copy to .env for local runs; in production set these in Dokploy.

# SRT publish credentials used by OBS:
#   srt://<vps>:8890?streamid=publish:ag:<user>:<pass>&latency=200000&pkt_size=1316
# Generate the password with: openssl rand -hex 24  (rotate after each AG)
RELAY_PUBLISH_USER=publisher
RELAY_PUBLISH_PASS=

# Public IPv4 of the VPS, advertised as WebRTC ICE candidate.
RELAY_PUBLIC_IP=

# Full RTMP(S) ingest URLs of the two YouTube live events (D9).
YOUTUBE_URL_A=rtmps://a.rtmps.youtube.com/live2/<key-A-room-sound>
YOUTUBE_URL_B=rtmps://a.rtmps.youtube.com/live2/<key-B-with-translation>

# Web app host serving /media/trad/whep, and its internal access-check endpoint.
APP_HOST=
RELAY_AUTH_URL=http://ag-app:3000/auth/media

# Opus bitrate of the interpretation feed (D3).
TRAD_BITRATE=48k
